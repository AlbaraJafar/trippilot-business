# ---- Database (SQLite for local dev; switch provider in prisma/schema.prisma for PostgreSQL) ----
DATABASE_URL="file:./dev.db"

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- PayPal (REST, server-side only — never expose the secret to the browser) ----
# Create a Sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PayPal REST APIs do not support SAR. Business amounts stay in SAR; the PayPal charge is made
# in this currency at the fixed 3.75 SAR/USD peg. Only USD conversion is implemented.
PAYPAL_CHARGE_CURRENCY=USD
# Optional: webhook id from the Sandbox app's webhook settings (enables signature verification)
PAYPAL_WEBHOOK_ID=
# Optional: timeout per PayPal HTTP call in ms (default 30000). A timed-out capture is recorded as
# CAPTURE_UNKNOWN and must be reconciled — it is never treated as failed.
PAYPAL_HTTP_TIMEOUT_MS=30000

# ---- Anthropic (optional — deterministic fallbacks are used when empty) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Flight provider: DEMO (default, simulated) or DUFFEL (live search only) ----
FLIGHT_PROVIDER=DEMO
DUFFEL_ACCESS_TOKEN=
